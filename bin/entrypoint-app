#!/bin/bash
set -euo pipefail

if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

DATA_ROOT="${DATA_ROOT:-/data}"
mkdir -p "$DATA_ROOT"

export PORT="${PORT:-8080}"

exec dotenvx run --quiet -- bundle exec falcon serve --bind tcp://0.0.0.0:${PORT:-8080}
